---
type Props = {
    metaData: {
        date: string;
        readTime: number;
        tags: string[];
        showTags: boolean;
    };
}

const {metaData} = Astro.props;

function groupTags(tags: string[], displayNumber: number): {displayTags: string[], hiddenTags: string[],}  {
    return {
        displayTags: tags.slice(0, displayNumber),
        hiddenTags: tags.slice(displayNumber)
    } 
}

const {displayTags, hiddenTags} = groupTags(metaData.tags, 3);
---

<div class="w-full flex justify-start items-center text-lg text-accent flex-wrap gap-2">
    <span>{metaData.date}</span> 
    <span>|</span>
    <span>{metaData.readTime} min</span>
    <span>|</span>
    { metaData.showTags ? ( 
        <>
            <span class="hidden md:inline-flex md:gap-2"> 
                {displayTags.map(tag => (
                    <span class="badge badge-outline badge-accent text-lg pr-2">#{tag}</span>
                ))}
            </span>
            <span class="md:hidden">Tags</span>
        </>
        ) : (
            <span>Tags</span>
    )}
    <!-- TODO: make the hover effect stay on screen when close to edges -->
    {metaData.showTags ? (
        <>
            <!-- showTags true on larger screen -->
            <span class={`hidden md:inline ${hiddenTags.length <= 0 || (`tooltip tooltip-bottom tooltip-primary`)}`} 
             data-tip={metaData.showTags && (hiddenTags.map(tag => tag).join(", "))}>
                <span class="link link-accent link-hover font-bold">
                    {`${hiddenTags.length <= 0 ? "" : `+${hiddenTags.length}`}`}
            </span>
            </span>

            <span class={`md:hidden ${metaData.tags.length <= 0 || (`tooltip tooltip-bottom tooltip-primary`)}`} 
             data-tip={metaData.tags.map(tag => tag).join(",")}>
                <span class="link link-accent link-hover font-bold">
                    +{metaData.tags.length}
                </span>
            </span>
        </>
    ) : (
    <!-- showTags false -->
         <span class={`${metaData.tags.length <= 0 || (`tooltip tooltip-bottom tooltip-primary`)}`} 
             data-tip={metaData.tags.map(tag => tag).join(", ")}>
            <span class="link link-accent link-hover font-bold">
                +{metaData.tags.length}
            </span>
        </span>
    )}
</div> 
