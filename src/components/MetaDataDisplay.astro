---
type Props = {
    metaData: {
        date: string;
        readTime: number;
        tags: string[];
        showTags: boolean;
    };
}

const {metaData} = Astro.props;

function groupTags(tags: string[], displayNumber: number): {displayTags: string[], hiddenTags: string[],}  {
    return {
        displayTags: tags.slice(0, displayNumber),
        hiddenTags: tags.slice(displayNumber)
    } 
}

const {displayTags, hiddenTags} = groupTags(metaData.tags, 3);
---

<div class="w-full flex justify-start items-center text-lg text-accent flex-wrap gap-2">
    <span>{metaData.date}</span> 
    <span>|</span>
    <span>{metaData.readTime} min</span>
    <span>|</span>
    { metaData.showTags ? ( 
        <>
            <span class="hidden md:inline"> 
                {displayTags.map(tag => (
                    <span class="badge badge-outline badge-primary text-lg">#{tag}</span>
                ))}
            </span>
            <span class="md:hidden">Tags</span>
        </>
        ) : (
            <span>Tags</span>
    )}
    <!-- TODO: make the hover effect stay on screen when close to edges -->
   <span class={`${(metaData.tags.length - displayTags.length) == 0 || (`tooltip tooltip-bottom tooltip-primary`)}`} 
    data-tip={hiddenTags.map(tag => tag).join(", ")}>
        {metaData.showTags ? (
            <span class="link link-accent link-hover font-bold hidden md:inline">+{metaData.tags.length - displayTags.length}</span>
            <span class="link link-accent link-hover font-bold md:hidden">+{metaData.tags.length}</span>
        ) : (
            <span class="link link-accent link-hover font-bold">+{metaData.tags.length}</span>
        )}
    </span>
</div> 
