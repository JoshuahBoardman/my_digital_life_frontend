---
type Props = {
	title: string;
};
const {title} = Astro.props;

---

<div class="w-full h-full max-h-[85vh] mockup-window shadow-neo-brute bg-base-200 backdrop-blur bg-neutral/75 rounded-regular">
    <div class="w-full absolute top-3 flex justify-center items-center pb-4">
      <h2 class="self-center text-lg font-bold tracking-widest">{title.replaceAll(/[- ]/g, '_')}</h2>
    </div>
    <div class="w-full h-full max-h-full px-8 py-8 bg-neutral overflow-x-hidden overflow-y-auto">
        <slot />  
    </div>
</div>
