---
import MetatDataDisplay from '../components/MetaDataDisplay.astro'

type Props = {
    // TODO: Add an array of icons type for the icons at the top of the card
    project: {
        title: string;
        //shortDescription: string;
        description: string; 
        postedDate: string; 
        image: string;
        articleUrl: string;      
        readTime: number;
        tags: string[];
        }
    };

const {project} = Astro.props;
---
<!-- TODO: Make the card a fixed height -->
<div class=`card card-bordered border-2 border-primary rounded-regular p-4 flex flex-col  
bg-base-100 relative gap-y-4`>
<h2 class="card-title text-3xl text-primary">{project.title}</h2>
<figure class="rounded-regular w-full overflow-hidden">
    <!-- TODO: make pass in alt text -->
    <img src={project.image} alt="project" class="w-full h-64 bg-mischka" />
    </figure>
    <div class="card-body w-full p-0 gap-y-4">
        <MetatDataDisplay metaData={{
            date: project.postedDate,
            readTime: project.readTime,
            tags: project.tags,
            showTags: false,
        }} />  
        <p class="text-xl">{project.description.slice(0, 99)}... 
            <span>
                <a href={project.articleUrl} class="link link-secondary text-xl">Read More</a>
            </span>
        </p>
    </div>
</div>
