---
import PageWrapperLayout from '../layouts/PageWrapperLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

---
<PageWrapperLayout title="Root" isHome={true}>
    <div class="grid gap-4 lg:grid-cols-2 lg:grid-rows-2">
        <div class="lg:row-span-2">
             <TerminalWindow title="welcome">
                   <div class="h-96">
                        <h1>Hello</h1>
                   </div> 
                    <div class="h-96">
                   </div> 
            </TerminalWindow>
        </div>
        <div class="hidden lg:block lg:col-start-2">
            <TerminalWindow title="my_content">
               <div class="h-28">
                    <h1>Hello</h1>
               </div>
            </TerminalWindow> 
        </div>
        <div class="hidden lg:block lg:row-start-2 lg:col-start-2">
            <TerminalWindow title="visual_effects">
               <div class="h-28">
                    <h1>Hello</h1>
               </div>
            </TerminalWindow> 
        </div>
    </div>
</PageWrapperLayout>
