---
import { getCollection } from 'astro:content';      
import PageWrapperLayout from '../layouts/PageWrapperLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import PortfolioCard from '../components/PortfolioCard.astro';

const portfolioEntries = await getCollection('portfolio');
---

<PageWrapperLayout title='Portfolio'>
    <TerminalWindow title='portfolio'>
        <div class="flex items-center justify-center flex-col gap-y-6"> 
            { portfolioEntries.sort((a,b) => ( 
              a.data.displayOrder - b.data.displayOrder 
            )).map(portfolioEntry => (
                <PortfolioCard project={{
                    title: portfolioEntry.data.title,
                    description: portfolioEntry.data.description,  
                    postedDate: portfolioEntry.data.publishDate.toDateString(),
                    image: portfolioEntry.data.imgUrl,
                    articleUrl: `/project/${portfolioEntry.slug}` 
                }} />
            ))}
        </div>
    </TerminalWindow>
</PageWrapperLayout>
